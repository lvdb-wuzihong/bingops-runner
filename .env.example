# bingops-runner 环境变量样例（复制为 .env 或直接注入容器）

# ---- Kafka（必填）----
KAFKA_BOOTSTRAP_SERVERS=kafka.internal:9092
KAFKA_DISPATCH_TOPIC=job-dispatch
KAFKA_EVENTS_TOPIC=job-events
KAFKA_GROUP_ID=bingops-runner

# ---- Vault AppRole（必填）----
VAULT_ADDR=https://vault.internal:8200
VAULT_ROLE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAULT_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAULT_KV_MOUNT=secret

# ---- GitLab 代码事实源（必填）----
GIT_REPO_URL=https://gitlab.internal/ops/infra.git
GIT_USERNAME=deploy-bot
GIT_TOKEN=glpat-xxxxxxxxxxxx

# ---- 运行时（可选）----
RUNNER_MAX_CONCURRENT=4
RUNNER_WORKDIR=/var/lib/bingops-runner
RUNNER_STEP_TIMEOUT_SEC=600
LOG_LEVEL=INFO
